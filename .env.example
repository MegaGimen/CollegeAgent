# Copy to collegeagent/.env (loaded by the core agent) and fill in.
# The Networker service needs DEEPSEEK_API_KEY and FIRECRAWL_API_KEY in its own environment.

# LLM provider
DEEPSEEK_API_KEY=

# Firecrawl, used when a page cannot be rendered locally
FIRECRAWL_API_KEY=

# Google OAuth, for Gmail and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Only for the Canvas test scripts in the repository root
CANVAS_TOKEN=

# Optional
AUTORAG_API_URL=http://127.0.0.1:8002
